#!/bin/sh

set -e

if [ -n "$SKIP_PRECOMMIT" ]; then
    echo "pre-commit: skipped (SKIP_PRECOMMIT is set)"
    exit 0
fi

cd "$(git rev-parse --show-toplevel)"

require() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "pre-commit: $1 is not installed."
        echo "            cargo install --locked $2"
        exit 1
    fi
}

require cargo-clippy clippy
require cargo-deny cargo-deny
require cargo-audit cargo-audit

echo "pre-commit: cargo fmt --all --check"
cargo fmt --all --check

echo "pre-commit: cargo clippy --all-targets --all-features -- -D warnings"
cargo clippy --all-targets --all-features -- -D warnings

echo "pre-commit: cargo deny --all-features check"
cargo deny --all-features check

echo "pre-commit: cargo audit --deny warnings --no-yanked"
cargo audit --deny warnings --no-yanked

echo "pre-commit: ok"
